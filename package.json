{
  "name": "eslint-plugin-diff",
  "version": "2.1.7",
  "description": "Run ESLint on your changes only",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "diff"
  ],
  "homepage": "https://github.com/paleite/eslint-plugin-diff#readme",
  "bugs": {
    "url": "https://github.com/paleite/eslint-plugin-diff/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paleite/eslint-plugin-diff.git"
  },
  "license": "MIT",
  "author": "Patrick Aleite <paleite@users.noreply.github.com> (https://github.com/paleite)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    ".github/ISSUE_TEMPLATE/feature_request.md",
    "/dist/",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "bench:preprocess-membership": "node scripts/benchmark-preprocessor-membership.ts",
    "clean": "tsc --build tsconfig.build.json --clean",
    "format": "prettier --write .",
    "lint": "eslint --cache --ext .js,.ts --fix .",
    "prepack": "pnpm run clean && pnpm run build",
    "lint:package": "pnpm run prepack && pnpm dlx publint --strict --pack pnpm",
    "lint:types": "pnpm run prepack && pnpm dlx @arethetypeswrong/cli --pack .",
    "release": "pnpm run lint:types && np --no-publish",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepare": "husky && (git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config blame.ignoreRevsFile .git-blame-ignore-revs || true)"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@paleite/jest-config": "^2.0.0",
    "@paleite/prettier-config": "^2.0.0",
    "@paleite/tsconfig-node-lts": "^2.0.0",
    "@paleite/tsconfig-strictest": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "np": "^7.7.0",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "ts-jest": "^29.4.6",
    "tsd": "^0.25.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "uuid": "^14.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
